<Page x:Class="UP01_Sedikov_Library.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Sedikov_Library.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegPage">

    <Grid Background="#F3F3F3">
        <Border Background="White" CornerRadius="10" Padding="30" Width="550" 
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Логин" Foreground="#0198AF" VerticalAlignment="Center" Margin="5,0,0,15"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,15">
                    <TextBox x:Name="txtbxLog" Height="35" Padding="5,0,0,0" 
                             VerticalContentAlignment="Center" TextChanged="txtbxLog_TextChanged"/>
                    <Label x:Name="lblLogHint" Content="Придумайте логин" Foreground="Gray" 
                           ToolTip="Введите логин"
                           Margin="10,0,0,0" VerticalAlignment="Center" 
                           MouseLeftButtonUp="lblLogHint_MouseLeftButtonUp"/>
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Пароль" Foreground="#0198AF" VerticalAlignment="Center" Margin="5,0,0,15"/>
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,15">
                    <PasswordBox x:Name="passBxFrst" Height="35" Padding="5,0,0,0" 
                                 VerticalContentAlignment="Center" 
                                 PasswordChanged="passBxFrst_PasswordChanged"/>
                    <Label x:Name="lblPassHint" Content="Введите пароль" Foreground="Gray" 
                           ToolTip="Минимум 6 символов, англ. буквы и цифры"
                           Margin="10,0,0,0" VerticalAlignment="Center" 
                           MouseLeftButtonUp="lblPassHint_MouseLeftButtonUp"/>
                </Grid>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Повторите пароль" Foreground="#0198AF" VerticalAlignment="Center" Margin="5,0,0,15"/>
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,15">
                    <PasswordBox x:Name="passBxScnd" Height="35" Padding="5,0,0,0" 
                                 VerticalContentAlignment="Center" 
                                 PasswordChanged="passBxScnd_PasswordChanged"/>
                    <Label x:Name="lblPassSecHint" Content="Повторите пароль" Foreground="Gray" 
                           ToolTip="Повторите пароль"
                           Margin="10,0,0,0" VerticalAlignment="Center" 
                           MouseLeftButtonUp="lblPassSecHint_MouseLeftButtonUp"/>
                </Grid>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Роль" Foreground="#0198AF" VerticalAlignment="Center" Margin="5,0,0,15"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="comboBox" Height="35" Margin="0,0,0,15" ToolTip="Выберите роль">
                    <ComboBoxItem Content="User" IsSelected="True"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="ФИО" Foreground="#0198AF" VerticalAlignment="Center" Margin="5,0,0,20"/>
                <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,20">
                    <TextBox x:Name="txtbxFIO" Height="35" Padding="5,0,0,0" 
                             VerticalContentAlignment="Center" TextChanged="txtbxFIO_TextChanged"/>
                    <Label x:Name="lblFioHint" Content="Иванов Иван Иванович" Foreground="Gray" 
                           ToolTip="Введите ваше ФИО"
                           Margin="10,0,0,0" VerticalAlignment="Center" 
                           MouseLeftButtonUp="lblFioHint_MouseLeftButtonUp"/>
                </Grid>

                <Button Grid.Row="6" Grid.ColumnSpan="2" x:Name="regButton" Content="Зарегистрироваться" 
                        ToolTip="Создать нового пользователя"
                        Height="35" Width="200" HorizontalAlignment="Center" Click="regButton_Click" Margin="0,0,0,10"/>

                <Button Grid.Row="6" Grid.ColumnSpan="2" x:Name="btnBack" Content="Назад" 
                        ToolTip="Вернуться на страницу входа"
                        Height="30" Width="200" HorizontalAlignment="Center" Background="Transparent" 
                        Foreground="#256569" BorderThickness="0" Cursor="Hand" Click="btnBack_Click" Margin="0,45,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Page>