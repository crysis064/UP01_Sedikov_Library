<Page x:Class="UP01_Sedikov_Library.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Sedikov_Library.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Смена пароля">

    <Grid Background="#F3F3F3">
        <Border Background="White" CornerRadius="10" Padding="30" Width="550" 
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Смена пароля" FontSize="24" FontWeight="Bold" 
                           Foreground="#233E76" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Логин" Foreground="#0198AF" VerticalAlignment="Center" Margin="5,0,0,15"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbLogin" Height="35" Margin="0,0,0,15" 
                         VerticalContentAlignment="Center" Padding="5,0,0,0" ToolTip="Введите ваш логин"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Текущий пароль" Foreground="#0198AF" VerticalAlignment="Center" Margin="5,0,0,15"/>
                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="CurrentPasswordBox" Height="35" Margin="0,0,0,15" 
                             VerticalContentAlignment="Center" Padding="5,0,0,0" ToolTip="Введите текущий пароль"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Новый пароль" Foreground="#0198AF" VerticalAlignment="Center" Margin="5,0,0,15"/>
                <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="NewPasswordBox" Height="35" Margin="0,0,0,15" 
                             VerticalContentAlignment="Center" Padding="5,0,0,0" ToolTip="Минимум 6 символов, англ. буквы и цифры"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Подтвердите пароль" Foreground="#0198AF" VerticalAlignment="Center" Margin="5,0,0,20"/>
                <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="ConfirmPasswordBox" Height="35" Margin="0,0,0,20" 
                             VerticalContentAlignment="Center" Padding="5,0,0,0" ToolTip="Повторите новый пароль"/>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Сохранить" Click="ButtonSave_Click" Width="150" Margin="5" ToolTip="Применить новый пароль"/>
                    <Button Content="Назад" Click="BtnBack_Click" Width="150" Margin="5" Background="Gray" ToolTip="Вернуться к авторизации"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>