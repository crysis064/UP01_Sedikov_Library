<Page x:Class="UP01_Sedikov_Library.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Sedikov_Library.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница пользователя">

    <Grid Background="#F3F3F3" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <TextBlock Text="Поиск по названию:" VerticalAlignment="Center" Foreground="#233E76"/>
            <TextBox x:Name="SearchTextBox" Width="150" Margin="5,0,15,0" TextChanged="SearchTextBox_TextChanged" ToolTip="Введите название книги"/>

            <TextBlock Text="Жанр:" VerticalAlignment="Center" Foreground="#233E76"/>
            <ComboBox x:Name="CategoryComboBox" Width="150" Margin="5,0,15,0" SelectionChanged="CategoryComboBox_SelectionChanged" DisplayMemberPath="Name" ToolTip="Выберите жанр"/>

            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Foreground="#233E76"/>
            <ComboBox x:Name="SortComboBox" Width="150" Margin="5,0,15,0" SelectionChanged="SortComboBox_SelectionChanged" SelectedIndex="0">
                <ComboBoxItem Content="По возрастанию (А-Я)"/>
                <ComboBoxItem Content="По убыванию (Я-А)"/>
            </ComboBox>

            <Button x:Name="ClearFiltersButton" Content="Очистить" Width="60" Click="ClearFiltersButton_Click" ToolTip="Сбросить фильтры"/>
        </WrapPanel>

        <ListView x:Name="BooksListView" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8" Margin="10" Padding="10" Width="220">
                        <Border.Effect>
                            <DropShadowEffect Color="Gray" BlurRadius="10" Opacity="0.2" ShadowDepth="0"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="#233E76" TextWrapping="Wrap" Margin="0,0,0,5"/>

                            <TextBlock Text="{Binding Author.FIO}" Foreground="Gray" FontStyle="Italic" Margin="0,0,0,5"/>

                            <TextBlock Text="Жанр: " Foreground="#0198AF">
                                <Run Text="{Binding Genres.Name}"/>
                            </TextBlock>

                            <TextBlock Text="В наличии: " Foreground="#0198AF">
                                <Run Text="{Binding Penalty, StringFormat={}{0:0}}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>