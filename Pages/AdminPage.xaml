<Page x:Class="UP01_Sedikov_Library.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Sedikov_Library.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdminPage">

    <Grid Background="#F3F3F3">
        <Border Background="White" CornerRadius="10" Padding="40"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Панель администратора" FontSize="26" FontWeight="Bold" 
                           Foreground="#233E76" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="BtnUsers" Content="Пользователи" ToolTip="Управление пользователями" 
                            Grid.Row="0" Grid.Column="0" Height="50" Margin="10" Click="BtnUsers_Click"/>

                    <Button x:Name="BtnGenres" Content="Жанры" ToolTip="Управление жанрами книг" 
                            Grid.Row="0" Grid.Column="1" Height="50" Margin="10" Click="BtnCategories_Click"/>

                    <Button x:Name="BtnAuthors" Content="Авторы" ToolTip="Управление авторами" 
                            Grid.Row="1" Grid.Column="0" Height="50" Margin="10" Click="BtnAuthors_Click"/>

                    <Button x:Name="BtnBooks" Content="Книги" ToolTip="Управление библиотечным фондом" 
                            Grid.Row="1" Grid.Column="1" Height="50" Margin="10" Click="BtnBooks_Click"/>

                    <Button x:Name="BtnLoans" Content="Выдачи" ToolTip="Учет выдачи книг" 
                            Grid.Row="2" Grid.Column="0" Height="50" Margin="10" Click="BtnLoans_Click"/>

                    <Button x:Name="BtnDiagrams" Content="Диаграммы" ToolTip="Аналитика и графики" 
                            Grid.Row="2" Grid.Column="1" Height="50" Margin="10" Click="BtnDiagrams_Click"/>

                    <Button x:Name="BtnLogout" Content="Выйти" ToolTip="Вернуться на страницу входа" 
                            Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                            Height="50" Width="200" Margin="10" 
                            HorizontalAlignment="Center" Background="#D44A42" Click="BtnLogout_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>