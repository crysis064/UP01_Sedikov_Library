<Page x:Class="UP01_Sedikov_Library.Pages.DiagrammPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Sedikov_Library.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Диаграмммы">

    <Grid Background="#F3F3F3" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,10">
            <TextBlock Text="Пользователь:" VerticalAlignment="Center" Foreground="#233E76"/>
            <ComboBox x:Name="CmbUser" Width="185" Margin="5,15,15,15" DisplayMemberPath="FIO" SelectionChanged="UpdateChart" ToolTip="Выберите пользователя"/>

            <TextBlock Text="Тип диаграммы:" VerticalAlignment="Center" Foreground="#233E76"/>
            <ComboBox x:Name="CmbDiagram" Width="150" Margin="5,15,15,15" SelectionChanged="UpdateChart" ToolTip="Выберите тип графика"/>

            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <Button Content="Экспорт в Excel" Click="ExportExcel_Click" Width="130" Margin="5,0,5,2" ToolTip="Выгрузить данные в Excel"/>
                <Button Content="Экспорт в Word" Click="ExportWord_Click" Width="130" Margin="5,2,5,0" ToolTip="Выгрузить данные в Word"/>
            </StackPanel>
        </WrapPanel>
        <Grid Grid.Row="1" Margin="5" x:Name="ChartContainer">
        </Grid>
    </Grid>
</Page>