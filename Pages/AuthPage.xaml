<Page x:Class="UP01_Sedikov_Library.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Sedikov_Library.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid Background="#F3F3F3">
        <Border Background="White" CornerRadius="10" Padding="40" Width="400" 
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="15" Opacity="0.3" ShadowDepth="0"/>
            </Border.Effect>

            <Grid>
                <StackPanel x:Name="LoginPanel" Panel.ZIndex="0">
                    <Grid Margin="0,0,0,15">
                        <TextBox x:Name="TextBoxLogin" Height="40" Padding="5,0,0,0" 
                                 VerticalContentAlignment="Center" TextChanged="TextBoxLogin_TextChanged"/>
                        <Label x:Name="txtHintLogin" Content="Введите логин" Foreground="Gray" 
                               ToolTip="Введите ваш логин"
                               Margin="10,0,0,0" VerticalAlignment="Center" MouseLeftButtonUp="txtHintLogin_MouseLeftButtonUp"/>
                    </Grid>

                    <Grid Margin="0,0,0,25">
                        <PasswordBox x:Name="PasswordBox" Height="40" Padding="5,0,0,0" 
                                     VerticalContentAlignment="Center" PasswordChanged="PasswordBox_PasswordChanged"/>
                        <Label x:Name="txtHintPass" Content="Введите пароль" Foreground="Gray" 
                               ToolTip="Введите ваш пароль"
                               Margin="10,0,0,0" VerticalAlignment="Center" MouseLeftButtonUp="txtHintPass_MouseLeftButtonUp"/>
                    </Grid>

                    <Button x:Name="ButtonEnter" Content="Войти" ToolTip="Войти в систему" 
                            Height="40" Width="200" HorizontalAlignment="Center" Click="ButtonEnter_OnClick"/>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ButtonReg" Content="Регистрация" ToolTip="Перейти к регистрации" Grid.Column="0" 
                                Background="Transparent" Foreground="#256569" BorderThickness="0" Cursor="Hand" Click="ButtonReg_Click"/>
                        <Button x:Name="ButtonChangePassword" Content="Сменить пароль" ToolTip="Изменить текущий пароль" Grid.Column="1" 
                                Background="Transparent" Foreground="#256569" BorderThickness="0" Cursor="Hand" Click="ButtonChangePassword_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed" Panel.ZIndex="1" Background="White">
                    <TextBlock Text="Вы робот?" Foreground="#D44A42" FontWeight="Bold" FontSize="18"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <TextBox CommandManager.PreviewExecuted="TextBox_PreviewExecuted" 
                             ContextMenu="{x:Null}" x:Name="captcha" Height="42" Foreground="Red" 
                             FontStyle="Italic" FontWeight="Heavy" Width="156" Background="#EAEBED" 
                             FontStretch="UltraCondensed" IsReadOnly="True" 
                             HorizontalContentAlignment="Center" HorizontalAlignment="Center" 
                             VerticalContentAlignment="Center" FontSize="20" Margin="0,0,0,10"/>

                    <TextBox x:Name="captchaInput" ToolTip="Введите код с картинки" Height="40" Width="156" HorizontalAlignment="Center" 
                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="16" Margin="0,0,0,15"/>

                    <Button x:Name="submitCaptcha" Content="Подтвердить" ToolTip="Проверить капчу" Height="40" Width="200" 
                            HorizontalAlignment="Center" Click="submitCaptcha_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>