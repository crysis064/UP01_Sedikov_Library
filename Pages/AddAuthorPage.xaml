<Page x:Class="UP01_Sedikov_Library.Pages.AddAuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Sedikov_Library.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddAuthorPage">

    <Grid Background="#F3F3F3">
        <Border Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Добавление автора" FontSize="20" FontWeight="Bold" Foreground="#233E76" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="ФИО Автора" Foreground="#0198AF"/>
                <TextBox x:Name="TBAuthorName" Text="{Binding FIO}" Margin="0,5,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Сохранить" Click="ButtonSave_Click" Margin="5"/>
                    <Button Content="Назад" Click="BtnBack_Click" Margin="5" Background="Gray"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>