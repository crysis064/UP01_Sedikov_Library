<Page x:Class="UP01_Sedikov_Library.AddBookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP01_Sedikov_Library"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddBookPage">

    <Grid Background="#F3F3F3">
        <Border Background="White" CornerRadius="10" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Добавление книги" FontSize="20" FontWeight="Bold" Foreground="#233E76" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="Название" Foreground="#0198AF"/>
                <TextBox x:Name="TBTitle" Margin="0,5,0,10"/>
                <TextBlock Text="Автор" Foreground="#0198AF"/>
                <ComboBox x:Name="CmbAuthor" DisplayMemberPath="FIO" Margin="0,5,0,10" ToolTip="Выберите автора"/>
                <TextBlock Text="Жанр" Foreground="#0198AF"/>
                <ComboBox x:Name="CmbGenre" DisplayMemberPath="Name" Margin="0,5,0,10" ToolTip="Выберите жанр"/>
                <TextBlock Text="Количество" Foreground="#0198AF"/>
                <TextBox x:Name="TBPenalty" Margin="0,5,0,20" PreviewTextInput="TBPenalty_PreviewTextInput" DataObject.Pasting="TBPenalty_Pasting"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Сохранить" Click="ButtonSave_Click" Margin="5"/>
                    <Button Content="Назад" Click="BtnBack_Click" Margin="5" Background="Gray"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>